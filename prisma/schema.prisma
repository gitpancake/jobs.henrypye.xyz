}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model catan_scores {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_id        String        @db.Uuid
  player_id      String        @db.Uuid
  victory_points Int           @default(0)
  settlements    Int           @default(0)
  cities         Int           @default(0)
  longest_road   Boolean       @default(false)
  largest_army   Boolean       @default(false)
  dev_points     Int           @default(0)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  dev_card_vp    Int           @default(0)
  catan_games    catan_games   @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catan_players  catan_players @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([game_id, player_id])
  @@index([game_id], map: "idx_catan_scores_game")
  @@index([player_id], map: "idx_catan_scores_player")
}

