  source          String
  documentId      String?
  createdAt       DateTime         @default(now())
  shelby_document shelby_document? @relation(fields: [documentId], references: [id])
  shelby_vehicle  shelby_vehicle   @relation(fields: [vehicleId], references: [id])
}

model shelby_service_line_item {
  id                    String                @id
  serviceRecordId       String
  description           String
  componentId           String
  cost                  Float?
  createdAt             DateTime              @default(now())
  shelby_component      shelby_component      @relation(fields: [componentId], references: [id])
  shelby_service_record shelby_service_record @relation(fields: [serviceRecordId], references: [id])
}

model shelby_service_record {
  id                       String                     @id
  vehicleId                String
  documentId               String?
  serviceDate              DateTime?                  @db.Date
  mileage                  Int?
  shop                     String?
  notes                    String?
  createdAt                DateTime                   @default(now())
  currency                 String                     @default("USD")
  shelby_note              shelby_note[]
  shelby_service_line_item shelby_service_line_item[]
  shelby_document          shelby_document?           @relation(fields: [documentId], references: [id])
  shelby_vehicle           shelby_vehicle             @relation(fields: [vehicleId], references: [id])
}

model shelby_vehicle {
  id                       String                     @id
  vin                      String                     @unique
  licensePlate             String
  mileage                  Int
  make                     String
  model                    String
  year                     Int
  trim                     String?
  bodyClass                String?
  driveType                String?
  engineCylinders          Int?
  engineModel              String?
  displacementL            Float?
  fuelType                 String?
  plantCountry             String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  user_id                  String
  team_id                  String                     @db.Uuid
  shelby_component         shelby_component[]
  shelby_diagnostic_report shelby_diagnostic_report[]
  shelby_document          shelby_document[]
  shelby_odometer_reading  shelby_odometer_reading[]
  shelby_service_record    shelby_service_record[]
  shared_teams             SharedTeam                 @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([team_id], map: "idx_shelby_vehicle_team_id")
  @@index([user_id], map: "idx_shelby_vehicle_user_id")
}

model trip_projects {
  id             String   @id
  title          String
  start_date     DateTime @db.Date
  end_date       DateTime @db.Date
  itinerary_text String
  route_hints    String?
  settings       Json
  days           Json
  created_at     BigInt
  updated_at     BigInt
  user_id        String
  team_id        String

  @@index([team_id], map: "idx_trip_projects_team_id")
  @@index([updated_at(sort: Desc)], map: "idx_trip_projects_updated_at")
  @@index([user_id], map: "idx_trip_projects_user_id")
}

enum OutreachMethod {
  LINKEDIN
  PHONE
  TEXT
  WHATSAPP
  TELEGRAM
  IN_PERSON
  EMAIL
  OTHER
}

enum JobStatus {
  APPLIED
  INTERVIEWING
  ACCEPTED
  REJECTED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NoteType {
  INSPECTION
  MEASUREMENT
  RECOMMENDATION
  CONCERN
  OBSERVATION
}
