generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Job {
  id                  String     @id @default(cuid())
  title               String
  company             String
  description         String?
  location            String?
  applicationDate     DateTime   @default(now())
  status              JobStatus  @default(APPLIED)
  linkedinContactUrl  String?
  linkedinContactName String?
  hasMessagedContact  Boolean    @default(false)
  notes               String?
  archived            Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  salaryMin           Int?
  salaryMax           Int?
  salaryCurrency      String?
  responsibilities    String[]   @default([])
  requirements        String[]   @default([])
  benefits            String[]   @default([])
  workArrangement     String?
  suitabilityScore    Int?
  suitabilityReason   String?
  aiAnalyzedAt        DateTime?
  suggestedNextSteps  String[]   @default([])
  userId              String     @map("user_id")
  teamId              String     @map("team_id") @db.Uuid
  shared_teams        SharedTeam @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teamId], map: "idx_jobs_team_id")
  @@index([userId], map: "idx_jobs_user_id")
  @@map("jobs")
}

model UserCV {
  id           String     @id @default(cuid())
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  userId       String     @map("user_id")
  teamId       String     @map("team_id") @db.Uuid
  shared_teams SharedTeam @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teamId], map: "idx_user_cv_team_id")
  @@index([userId], map: "idx_user_cv_user_id")
  @@map("user_cv")
}

model Outreach {
  id            String         @id @default(cuid())
  contactName   String
  contactTitle  String?
  company       String
  method        OutreachMethod
  bio           String?
  notes         String?
  responded     Boolean        @default(false)
  responseDate  DateTime?
  outreachDate  DateTime       @default(now())
  archived      Boolean        @default(false)
  userId        String         @map("user_id")
  teamId        String         @map("team_id") @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shared_teams  SharedTeam     @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teamId], map: "idx_outreach_team_id")
  @@index([userId], map: "idx_outreach_user_id")
  @@map("outreach")
}

model SharedUser {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid  String             @unique @map("firebase_uid")
  email        String
  displayName  String?            @map("display_name")
  photoUrl     String?            @map("photo_url")
  createdAt    DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitesSent  SharedTeamInvite[] @relation("InvitesSent")
  memberships  SharedTeamMember[]
  createdTeams SharedTeam[]       @relation("CreatedTeams")

  @@index([firebaseUid], map: "idx_shared_users_firebase_uid")
  @@map("shared_users")
}

model SharedTeam {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  createdBy      String             @map("created_by") @db.Uuid
  createdAt      DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  safe_mode      Boolean            @default(false)
  jobs           Job[]
  outreach       Outreach[]
  invites        SharedTeamInvite[]
  members        SharedTeamMember[]
  creator        SharedUser         @relation("CreatedTeams", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shelby_vehicle shelby_vehicle[]
  user_cv        UserCV[]

  @@map("shared_teams")
}

model SharedTeamMember {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId   String     @map("team_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     String
  joinedAt DateTime?  @default(now()) @map("joined_at") @db.Timestamptz(6)
  team     SharedTeam @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     SharedUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teamId, userId], name: "teamId_userId")
  @@index([teamId], map: "idx_shared_team_members_team_id")
  @@index([userId], map: "idx_shared_team_members_user_id")
  @@map("shared_team_members")
}

model SharedTeamInvite {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String     @map("team_id") @db.Uuid
  invitedBy  String     @map("invited_by") @db.Uuid
  email      String
  role       String
  token      String     @unique
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(6)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  inviter    SharedUser @relation("InvitesSent", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team       SharedTeam @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teamId, email], name: "teamId_email")
  @@index([email], map: "idx_shared_team_invites_email")
  @@index([token], map: "idx_shared_team_invites_token")
  @@map("shared_team_invites")
}

model catan_futures_contract {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  maker           String
  taker           String   @default("")
  requestAmount   Int
  requestResource String
  repayAmount     Int
  repayResource   String
  turnsToRepay    Int
  penaltyAmount   Int
  penaltyResource String
  turnsElapsed    Int      @default(0)
  status          String   @default("open")
  createdAt       DateTime @default(now())
}

model catan_games {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  league_id     String         @db.Uuid
  played_at     DateTime       @default(now()) @db.Timestamptz(6)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  created_by    String?
  catan_leagues catan_leagues  @relation(fields: [league_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catan_scores  catan_scores[]

  @@index([league_id], map: "idx_catan_games_league")
  @@index([played_at(sort: Desc)], map: "idx_catan_games_played_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model catan_league_members {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  league_id     String        @db.Uuid
  firebase_uid  String
  role          String        @default("participant")
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  catan_leagues catan_leagues @relation(fields: [league_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([league_id, firebase_uid])
  @@index([league_id], map: "idx_catan_league_members_league")
  @@index([firebase_uid], map: "idx_catan_league_members_uid")
}

model catan_leagues {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @unique
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  created_by           String?
  catan_games          catan_games[]
  catan_league_members catan_league_members[]
}

model catan_players {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @unique
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
